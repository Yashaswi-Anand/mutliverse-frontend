# ============================================================
# Multiverse site — Apache / LiteSpeed config
# Hostinger deploys this repo by `git pull`, so this file is the
# only place server behaviour can be set. It ships with the site.
# ============================================================

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- 1. Force HTTPS -----------------------------------------------------
  # Google Play rejects a privacy policy URL that is not reachable over
  # https, and Hostinger terminates TLS upstream — so test the forwarded
  # header as well as HTTPS, or this loops forever behind their proxy.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- 2. Also serve /privacy from privacy.html ---------------------------
  # Both forms work. Pages link to /privacy.html, which resolves on ANY
  # server — including a plain `python -m http.server` during development,
  # which does not read this file at all. /privacy stays available as the
  # tidier public address, and is what rel="canonical" and the Play Console
  # listing use.
  #
  # There is deliberately NO redirect from .html back to the clean form.
  # It would add a 301 to every internal click, and matching it safely needs
  # a THE_REQUEST condition that is by far the easiest rule here to turn
  # into a redirect loop. Serving both costs nothing, and canonical already
  # tells search engines which one counts.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# --- Security headers -----------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # No camera, mic or location is used anywhere on this site.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Caching --------------------------------------------------------------
# CSS and JS are cached for a week. Both are shared across every page, so
# when either changes, rename it or append ?v=2 in the pages that load it —
# otherwise returning visitors keep the old copy until it expires.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml         "access plus 30 days"
  ExpiresByType image/png             "access plus 30 days"
  # HTML stays fresh: the privacy policy has to be able to change today.
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

# --- Compression ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

# --- Keep repository files from being served ------------------------------
<FilesMatch "^(README\.md|\.gitignore|\.git.*)$">
  Require all denied
</FilesMatch>
